amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

// Git hooks call the Justfile, never the tools behind it (README.md, Checks).
hooks {
    // Fix, then check, the staged files only; unstaged work is stashed meanwhile.
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ["just"] {
                glob = "**/*"
                check = "just lint staged"
                fix = "just fmt staged && just lint staged"
            }
        }
    }
    // Run the full checks, and audit, before anything leaves the machine: its record is the PR gate's proof.
    ["pre-push"] {
        steps {
            ["just"] {
                glob = "**/*"
                check = "just check && just audit"
            }
        }
    }
}
